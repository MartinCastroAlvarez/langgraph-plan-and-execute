# Copy to .env (never commit it). Every variable is optional.
PLAN_EXECUTE_PROVIDER=ollama            # ollama | anthropic | fake
PLAN_EXECUTE_MODEL=qwen3:4b             # claude-sonnet-5-5 for anthropic
OLLAMA_HOST=http://127.0.0.1:11434      # loopback only unless the next line is 1
PLAN_EXECUTE_ALLOW_REMOTE_OLLAMA=
PLAN_EXECUTE_TEMPERATURE=0
PLAN_EXECUTE_MAX_STEPS=8
PLAN_EXECUTE_MAX_REPLANS=3
PLAN_EXECUTE_MAX_TOOL_CALLS=12
PLAN_EXECUTE_MAX_STEP_TOOL_CALLS=3
PLAN_EXECUTE_APPROVE=                   # 1 = pause for plan review (interrupt)
PLAN_EXECUTE_NOTES_DIR=                 # a folder of .md/.txt notes; default: the bundled ones
PLAN_EXECUTE_TODAY=                     # YYYY-MM-DD, fixes "today" for the date tool
PLAN_EXECUTE_FAKE_LATENCY=0
PLAN_EXECUTE_TOOL_LATENCY=0
# Only for the optional Anthropic adapter (pip install ".[anthropic]"):
# ANTHROPIC_API_KEY=
